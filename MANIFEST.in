include LICENSE AGENTS.md README.md pyproject.toml .gitattributes .gitignore
include .github/CONTRIBUTING.md
include .github/workflows/ci.yml
recursive-include src *.py *.mjs *.html *.css *.js
recursive-include tests *.py
recursive-include docs *.md *.svg
recursive-include scripts *.py *.cmd *.mjs
recursive-include examples *.py *.txt *.example
recursive-include skills *.md *.yaml *.py *.json
prune .git
prune .local
prune release
prune runs
prune downloads
prune .venv
prune node_modules
global-exclude __pycache__ *.py[cod] *.dpapi
