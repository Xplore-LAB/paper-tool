include LICENSE AGENTS.md DESIGN.md README.md CHANGELOG.md CONTRIBUTING.md
include requirements.txt requirements-dev.txt .env.example .gitattributes .gitignore
include paper-tool paper-tool.cmd browser_pdf.mjs build_release.py _gen_launcher.py generate-report.cmd progress.cmd
recursive-include paper_tool_assets *.py *.mjs
recursive-include tests *.py
recursive-include docs *.md
recursive-include examples *.py *.txt
prune .git
prune .local
prune release
prune runs
prune downloads
prune .venv
prune node_modules
global-exclude __pycache__ *.py[cod] *.dpapi
