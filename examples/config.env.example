# Environment-variable template; .env files are NOT loaded automatically.
# Set these variables in your shell before running paper-tool.
# All of these are optional; the tool works without them.

# Polite-pool / higher rate limits for the metadata APIs.
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=you@example.edu

# Only needed when the Zotero local API is behind an explicit key.
# Normally authorization is granted in the Zotero desktop dialog instead.
ZOTERO_LOCAL_API_KEY=

# Only needed if playwright-core is installed outside node_modules.
PLAYWRIGHT_CORE_PATH=

# Optional default for examples/recover_local_pdfs.py.
PAPER_COLLECTION=My Library/Papers

# Optional deployment defaults (these are environment variables, not a .env loader).
# PAPER_TOOL_OUT=/path/to/papers
# PAPER_TOOL_PROXY=direct
# PAPER_TOOL_ZOTERO_BASE=http://127.0.0.1:23119/api
