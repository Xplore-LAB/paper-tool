#!/bin/sh
TASK_ENTRY=$0
while [ -L "$TASK_ENTRY" ]; do
  TASK_LINK_DIR=$(CDPATH= cd -- "$(dirname -- "$TASK_ENTRY")" && pwd)
  TASK_LINK=$(readlink "$TASK_ENTRY") || exit 1
  case "$TASK_LINK" in
    /*) TASK_ENTRY=$TASK_LINK ;;
    *) TASK_ENTRY=$TASK_LINK_DIR/$TASK_LINK ;;
  esac
done
TASK_DIR=$(CDPATH= cd -- "$(dirname -- "$TASK_ENTRY")/.." && pwd)
if [ -x "$TASK_DIR/.venv/bin/python" ]; then
  PY="$TASK_DIR/.venv/bin/python"
else
  PY=python3
fi
exec "$PY" -m paper_tool.cli "$@"
